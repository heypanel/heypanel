<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <parameters>
        <parameter key="env(HEYADMIN_ADMINISTRATION_PATH_NAME)">admin</parameter>
        <parameter key="heypanel_administration.path_name">%env(resolve:HEYADMIN_ADMINISTRATION_PATH_NAME)%</parameter>
    </parameters>

    <services>
        <service id="HeyPanel\Administration\Command\DeleteAdminFilesAfterBuildCommand">
            <tag name="console.command"/>
        </service>

        <service id="HeyPanel\Administration\Command\DeleteExtensionLocalPublicFilesCommand">
            <argument type="service" id="kernel"/>
            <tag name="console.command"/>
        </service>

        <service id="HeyPanel\Administration\Controller\UserConfigController" public="true">
            <argument type="service" id="user_config.repository"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>

            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
        <service id="HeyPanel\Administration\Controller\AdministrationController"
                 public="true">
            <argument type="service" id="HeyPanel\Core\Framework\Adapter\Twig\TemplateFinder"/>
            <argument type="service" id="HeyPanel\Core\Framework\Store\Services\FirstRunWizardService"/>
            <argument type="service" id="HeyPanel\Administration\Snippet\SnippetFinder"/>
            <argument>%kernel.supported_api_versions%</argument>
            <argument type="service" id="HeyPanel\Administration\Framework\Routing\KnownIps\KnownIpsCollector"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="event_dispatcher"/>
            <argument>%kernel.heypanel_core_dir%</argument>
            <argument type="service" id="customer.repository"/>
            <argument type="service" id="currency.repository"/>
            <argument type="service" id="HeyPanel\Core\Framework\Util\HtmlSanitizer"/>
            <argument type="service" id="HeyPanel\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="parameter_bag"/>
            <argument type="service" id="HeyPanel\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="heypanel.filesystem.asset"/>
            <argument type="string">%heypanel.api.refresh_token_ttl%</argument>

            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="HeyPanel\Administration\Framework\Twig\ViteFileAccessorDecorator"
                 decorates="pentatrion_vite.file_accessor">
            <argument>%pentatrion_vite.configs%</argument>
            <argument type="service" id="heypanel.asset.asset"/>
            <argument type="service" id="kernel"/>
            <argument type="service" id="filesystem"/>
        </service>

        <service id="HeyPanel\Administration\Snippet\SnippetFinder">
            <argument type="service" id="kernel"/>
        </service>

        <service id="HeyPanel\Administration\Snippet\CachedSnippetFinder"
                 decorates="HeyPanel\Administration\Snippet\SnippetFinder">
            <argument type="service" id="HeyPanel\Administration\Snippet\CachedSnippetFinder.inner"/>
            <argument type="service" id="cache.object"/>
        </service>

        <service id="HeyPanel\Administration\Framework\Routing\KnownIps\KnownIpsCollector"/>
        <service id="HeyPanel\Administration\Framework\Routing\NotFound\AdministrationNotFoundSubscriber">
            <argument>%heypanel_administration.path_name%</argument>
            <argument type="service" id="service_container"/>

            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="HeyPanel\Administration\Framework\Routing\AdministrationRouteScope">
            <argument>%heypanel_administration.path_name%</argument>
            <tag name="heypanel.route_scope"/>
        </service>

    </services>
</container>
