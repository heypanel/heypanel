{% block sw_flow_change_member_group_modal %}
<sw-modal
    class="sw-flow-change-member-group-modal"
    :title="$tc('sw-flow.modals.memberGroup.titleChangeCustomerGroup')"
    :closable="false"
    @modal-close="onClose"
>
    {% block sw_flow_change_member_group_modal_select %}
    <sw-entity-single-select
        v-model:value="memberGroupId"
        name="sw-field--memberGroupId"
        required
        class="sw-flow-change-member-group-modal__type-select"
        entity="member_group"
        label-property="translated.name"
        value-property="id"
        :criteria="memberGroupCriteria"
        :label="$tc('sw-flow.modals.memberGroup.labelCustomerGroup')"
        :placeholder="$tc('sw-flow.modals.memberGroup.placeholderCustomerGroup')"
        :error="fieldError"
    />
    {% endblock %}

    {% block sw_flow_change_member_group_modal_content_custom %}
    {% endblock %}

    {% block sw_flow_change_member_group_modal_footer %}
    <template #modal-footer>
        {% block sw_flow_change_member_group_modal_footer_cancel_button %}
        <mt-button
            class="sw-flow-change-member-group-modal__cancel-button"
            size="small"
            variant="secondary"
            @click="onClose"
        >
            {{ $tc('global.default.cancel') }}
        </mt-button>
        {% endblock %}

        {% block sw_flow_change_member_group_modal_footer_save_button %}
        <mt-button
            class="sw-flow-change-member-group-modal__save-button"
            variant="primary"
            size="small"
            @click="onAddAction"
        >
            {{ sequence.id ? $tc('sw-flow.modals.buttonSaveAction') : $tc('sw-flow.modals.buttonAddAction') }}
        </mt-button>
        {% endblock %}
    </template>
    {% endblock %}
</sw-modal>
{% endblock %}
