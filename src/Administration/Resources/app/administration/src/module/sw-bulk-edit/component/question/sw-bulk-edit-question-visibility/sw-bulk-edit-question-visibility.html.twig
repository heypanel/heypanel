{% block sw_bulk_edit_question_visibility %}
<div class="sw-bulk-edit-question-visibility">
    {% block sw_bulk_edit_question_visibility_select %}
    <sw-inherit-wrapper
        ref="questionVisibilitiesInheritance"
        v-model:value="question.visibilities"
        :inherited-value="question.visibilities"
        class="sw-question-category-form__visibility_field"
        :custom-remove-inheritance-function="visibilitiesRemoveInheritanceFunction"
        is-association
    >
        <template #content="{ currentValue, isInherited, updateCurrentValue }">
            <sw-question-visibility-select
                ref="questionVisibility"
                :key="isInherited"
                class="sw-question-detail__select-visibility"
                :entity-collection="currentValue"
                :placeholder="$tc('sw-question.visibility.placeholderVisibility')"
                :disabled="disabled || undefined"
                @update:entity-collection="updateCurrentValue"
            />
        </template>
    </sw-inherit-wrapper>
    {% endblock %}

    {% block sw_bulk_edit_question_visibility_advanced %}
    <sw-container
        v-if="question.visibilities.length > 0"
        columns="1fr"
        justify="end"
    >
        <a
            class="sw-card__quick-link advanced-visibility"
            :class="{ 'is--disabled': disabled }"
            role="button"
            tabindex="0"
            @click="openModal"
            @keydown.enter="openModal"
        >
            {{ $tc('sw-question.visibility.linkAdvancedVisibility') }}
            <mt-icon
                name="regular-long-arrow-right"
                size="16px"
            />
        </a>
    </sw-container>
    {% endblock %}

    {% block sw_bulk_edit_question_visibility_advanced_modal %}
    <sw-modal
        v-if="displayVisibilityDetail"
        :title="$tc('sw-question.visibility.textHeadline')"
        class="sw-question-category-form__visibility_modal"
        variant="large"
        @modal-close="closeModal"
    >
        <p>{{ $tc('sw-question.visibility.visibilityModalDescription') }}</p>

        <sw-question-visibility-detail />

        <template #modal-footer>
            <mt-button
                variant="primary"
                size="small"
                @click="closeModal"
            >
                {{ $tc('global.default.apply') }}
            </mt-button>
        </template>
    </sw-modal>
    {% endblock %}
</div>
{% endblock %}
