{% block sw_channel_questions_assignment_dynamic_question_groups %}
<div
    v-if="questionStreams"
    class="sw-channel-questions-assignment-dynamic-question-groups"
>
    {% block sw_channel_questions_assignment_dynamic_question_groups_info_text %}
    <mt-banner ref="alert">
        {{ $tc('sw-channel.detail.questionAssignmentModal.dynamicProductGroups.infoText') }}
    </mt-banner>
    {% endblock %}

    {% block sw_channel_questions_assignment_dynamic_question_groups_listing %}
    <mt-card
        :is-loading="isProductLoading"
        position-identifier="sw-channel-questions-assignment-dynamic-question-groups"
    >
        <template #grid>
            {% block sw_channel_questions_assignment_dynamic_question_groups_listing_container %}
            <div :style="containerStyle">
                {% block sw_channel_questions_assignment_dynamic_question_groups_listing_section %}
                <sw-card-section
                    ref="cardSectionSecondary"
                    secondary
                    divider="bottom"
                >
                    {% block sw_channel_questions_assignment_dynamic_question_groups_listing_search %}
                    <sw-simple-search-field
                        v-model:value="term"
                        variant="form"
                        size="small"
                        :placeholder="$tc('sw-channel.detail.questionAssignmentModal.dynamicProductGroups.searchFieldPlaceholder')"
                        @search-term-change="onSearch"
                    />
                    {% endblock %}
                </sw-card-section>
                {% endblock %}

                {% block sw_channel_questions_assignment_dynamic_question_groups_card_section_primary %}
                <sw-card-section class="sw-channel-questions-assignment-dynamic-question-groups__card-section-primary">
                    {% block sw_channel_questions_assignment_dynamic_question_groups_listing_entity %}
                    <sw-entity-listing
                        v-if="questionStreams.length > 0"
                        ref="questionStreamListing"
                        identifier="sw-channel-questions-assignment-dynamic-question-groups-listing"
                        :items="questionStreams"
                        :data-source="questionStreams"
                        :columns="questionStreamColumns"
                        :repository="questionStreamRepository"
                        :is-loading="isProductStreamsLoading"
                        :skeleton-item-amount="limit"
                        :plain-appearance="true"
                        :show-settings="false"
                        :allow-column-edit="false"
                        :allow-inline-edit="false"
                        @selection-change="onSelect"
                        @select-item="onSelect"
                        @select-all-items="onSelect"
                    >
                        <template #bulk>
                            {% block sw_channel_questions_assignment_dynamic_question_groups_listing_bulk %}
                            <span></span>
                            {% endblock %}
                        </template>

                        <template #delete-action="{ item }">
                            {% block sw_channel_questions_assignment_dynamic_question_groups_listing_delete_action %}
                            <span
                                class="sw-channel-questions-assignment-dynamic-question-groups__link-open"
                                role="button"
                                tabindex="0"
                                @click="onOpen(item)"
                                @keydown.enter="onOpen(item)"
                            >
                                {{ $tc('global.default.open') }}
                            </span>
                            {% endblock %}
                        </template>

                        <template #pagination>
                            {% block sw_channel_questions_assignment_dynamic_question_groups_listing_pagination %}
                            <sw-pagination
                                v-bind="{ page, limit, total }"
                                :total-visible="3"
                                :auto-hide="false"
                                @page-change="onPaginate"
                            />
                            {% endblock %}
                        </template>
                    </sw-entity-listing>
                    {% endblock %}

                    {% block sw_channel_questions_assignment_dynamic_question_groups_listing_empty %}
                    <sw-empty-state
                        v-if="questionStreams.length <= 0"
                        :show-description="false"
                        :title="questionStreams.length <= 0 && term
                            ? $tc('sw-channel.detail.questionAssignmentModal.dynamicProductGroups.titleNoProductStreamsMatching')
                            : $tc('sw-channel.detail.questionAssignmentModal.dynamicProductGroups.titleNoProductStreamsAvailable')
                        "
                    >
                        <template #icon>
                            {% block sw_channel_questions_assignment_dynamic_question_groups_listing_empty_icon %}
                            <img
                                :src="assetFilter('/administration/administration/static/img/empty-states/questions-empty-state.svg')"
                                alt=""
                            >
                            {% endblock %}
                        </template>
                    </sw-empty-state>
                    {% endblock %}
                </sw-card-section>
                {% endblock %}
            </div>
            {% endblock %}
        </template>
    </mt-card>
    {% endblock %}
</div>
{% endblock %}
