{% block sw_channel_questions_assignment_modal %}
<sw-modal
    class="sw-channel-questions-assignment-modal"
    :title="$tc('sw-channel.detail.questionAssignmentModal.title')"
    @modal-close="onCloseModal"
>
    <template #default>
        {% block sw_channel_questions_assignment_modal_tabs %}
        <sw-tabs
            class="sw-channel-questions-assignment-modal__tabs"
            position-identifier="sw-channel-questions-assignment-modal"
            default-item="singleProducts"
        >
            <template #default="{ active }">
                {% block sw_channel_questions_assignment_modal_tabs_single_questions %}
                <sw-tabs-item
                    name="singleProducts"
                    :title="$tc('sw-channel.detail.questionAssignmentModal.singleProducts')"
                    :active-tab="active"
                >
                    {{ $tc('sw-channel.detail.questionAssignmentModal.singleProducts') }}
                </sw-tabs-item>
                {% endblock %}

                {% block sw_channel_questions_assignment_modal_tabs_categories %}
                <sw-tabs-item
                    name="categories"
                    :title="$tc('sw-channel.detail.questionAssignmentModal.categories.title')"
                    :active-tab="active"
                >
                    {{ $tc('sw-channel.detail.questionAssignmentModal.categories.title') }}
                </sw-tabs-item>
                {% endblock %}

                {% block sw_channel_questions_assignment_modal_tab_dynamic_question_groups %}
                <sw-tabs-item
                    name="dynamicProductGroups"
                    :title="$tc('sw-channel.detail.questionAssignmentModal.dynamicProductGroups.title')"
                    :active-tab="active"
                >
                    {{ $tc('sw-channel.detail.questionAssignmentModal.dynamicProductGroups.title') }}
                </sw-tabs-item>
                {% endblock %}
            </template>

            <template #content="{ active }">
                <div
                    class="sw-channel-questions-assignment-modal__content"
                    :height="tabContentHeight"
                >
                    {% block sw_channel_questions_assignment_modal_tab_content_single_questions %}
                    <sw-channel-questions-assignment-single-questions
                        ref="question"
                        v-hide="active === 'singleProducts'"
                        :channel="channel"
                        :container-style="questionContainerStyle"
                        @selection-change="onChangeSelection"
                    />
                    {% endblock %}

                    {% block sw_channel_questions_assignment_modal_tab_content_categories %}
                    <sw-channel-question-assignment-categories
                        ref="category"
                        v-hide="active === 'categories'"
                        :channel="channel"
                        :container-style="categoryContainerStyle"
                        @selection-change="onChangeSelection"
                        @question-loading="setProductLoading"
                    />
                    {% endblock %}

                    {% block sw_channel_questions_assignment_modal_tab_content_dynamic_question_groups %}
                    <sw-channel-questions-assignment-dynamic-question-groups
                        ref="questionGroup"
                        v-hide="active === 'dynamicProductGroups'"
                        :channel="channel"
                        :container-style="questionGroupContainerStyle"
                        @selection-change="onChangeSelection"
                        @question-loading="setProductLoading"
                    />
                    {% endblock %}
                </div>
            </template>
        </sw-tabs>
        {% endblock %}
    </template>

    <template #modal-footer>
        {% block sw_channel_questions_assignment_modal_footer_cancel %}
        <mt-button
            class="sw-channel-questions-assignment-modal__close-button"
            size="small"
            variant="secondary"
            @click="onCloseModal"
        >
            {{ $tc('global.default.cancel') }}
        </mt-button>
        {% endblock %}

        {% block sw_channel_questions_assignment_modal_footer_submit %}
        <mt-button
            size="small"
            variant="primary"
            :is-loading="isAssignProductLoading || isProductLoading"
            @click="onAddProducts"
        >
            {{ $tc('sw-channel.detail.questions.buttonAddProducts', { questionCount: questionCount }, questionCount) }}
        </mt-button>
        {% endblock %}
    </template>
</sw-modal>
{% endblock %}
