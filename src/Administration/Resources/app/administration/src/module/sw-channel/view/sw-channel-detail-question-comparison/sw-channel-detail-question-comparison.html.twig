{% block sw_channel_detail_base %}
<div class="sw-channel-detail-question-comparison">

    {% block sw_channel_detail_question_comparison %}
    <mt-card
        key="edit"
        position-identifier="sw-channel-detail-question-comparison"
        :is-loading="isLoading"
        :title="$tc('sw-channel.detail.titleProductComparisonTemplate')"
    >

        {% block sw_channel_detail_question_comparison_header %}
        <sw-container>
            {% block sw_channel_detail_question_comparison_input_header %}
            <sw-code-editor
                v-model:value="questionExport.headerTemplate"
                :label="$tc('sw-channel.detail.questionComparison.inputHeaderLabel')"
                :completer-function="outerCompleterFunctionHeader"
                :editor-config="editorConfig"
                completion-mode="entity"
                mode="twig"
                :soft-wraps="true"
                :set-focus="false"
                :disabled="!acl.can('channel.editor')"
                @update:value="resetValid"
                @blur="resetValid"
            />
            {% endblock %}
        </sw-container>
        {% endblock %}

        {% block sw_channel_detail_question_comparison_body %}
        <sw-container>
            {% block sw_channel_detail_question_comparison_input_body %}
            <sw-code-editor
                v-model:value="questionExport.bodyTemplate"
                :label="$tc('sw-channel.detail.questionComparison.inputBodyLabel')"
                :completer-function="outerCompleterFunctionBody"
                :editor-config="editorConfig"
                completion-mode="entity"
                mode="twig"
                :soft-wraps="true"
                :set-focus="false"
                :disabled="!acl.can('channel.editor')"
                @update:value="resetValid"
                @blur="resetValid"
            />
            {% endblock %}
        </sw-container>
        {% endblock %}

        {% block sw_channel_detail_question_comparison_footer %}
        <sw-container>
            {% block sw_channel_detail_question_comparison_input_footer %}
            <sw-code-editor
                v-model:value="questionExport.footerTemplate"
                :label="$tc('sw-channel.detail.questionComparison.inputFooterLabel')"
                :completer-function="outerCompleterFunctionFooter"
                :editor-config="editorConfig"
                completion-mode="entity"
                mode="twig"
                :soft-wraps="true"
                :set-focus="false"
                :disabled="!acl.can('channel.editor')"
                @update:value="resetValid"
                @blur="resetValid"
            />
            {% endblock %}
        </sw-container>
        {% endblock %}

        {% block sw_channel_detail_question_comparison_actions %}
        <div class="sw-channel-detail-question-comparison__button-group">
            {% block sw_channel_detail_question_comparison_actions_test_button %}
            <sw-button-process
                size="small"
                variant="primary"
                ghost
                class="sw-channel-detail-question-comparison__button sw-channel-detail-question-comparison__test-action"
                :is-loading="isLoadingValidate"
                :disabled="isLoadingValidate || (!questionExport.headerTemplate && !questionExport.bodyTemplate && !questionExport.footerTemplate)"
                :process-success="isValidateSuccessful"
                @click="validateTemplate"
            >
                {{ $tc('sw-channel.detail.questionComparison.buttonTestLabel') }}
            </sw-button-process>
            {% endblock %}

            {% block sw_channel_detail_question_comparison_actions_preview_button %}
            <sw-button-process
                size="small"
                variant="primary"
                ghost
                class="sw-channel-detail-question-comparison__button sw-channel-detail-question-comparison__preview-action"
                :is-loading="isLoadingPreview"
                :disabled="isLoadingPreview || (!questionExport.headerTemplate && !questionExport.bodyTemplate && !questionExport.footerTemplate)"
                :process-success="isPreviewSuccessful"
                @click="preview"
            >
                {{ $tc('sw-channel.detail.questionComparison.buttonPreviewLabel') }}
            </sw-button-process>
            {% endblock %}

            {% block sw_channel_detail_question_comparison_actions_preview_component %}
            <sw-channel-detail-question-comparison-preview
                :content="previewContent"
                :errors="previewErrors"
                @close="onPreviewClose"
            />
            {% endblock %}
        </div>
        {% endblock %}
    </mt-card>
    {% endblock %}
</div>
{% endblock %}
