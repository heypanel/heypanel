{% block sw_channel_detail_questions %}
<mt-card
    v-if="channel && questions"
    position-identifier="sw-channel-detail-questions"
    class="sw-channel-detail-questions"
    :is-loading="isLoading || undefined"
>
    {% block sw_channel_detail_questions_filled_state %}
    <template
        v-if="questions.length > 0 || searchTerm"
        #grid
    >
        {% block sw_channel_detail_questions_card_section %}
        <sw-container rows="auto 500px">
            {% block sw_channel_detail_questions_card_section_secondary %}
            <sw-card-section secondary>
                <sw-container
                    columns="1fr auto"
                    gap="0 15px"
                >
                    {% block sw_channel_detail_questions_card_section_secondary_input %}
                    <sw-simple-search-field
                        v-model:value="searchTerm"
                        variant="form"
                        size="small"
                        @search-term-change="onChangeSearchTerm"
                    />
                    {% endblock %}

                    {% block sw_channel_detail_questions_card_section_secondary_button %}
                    <mt-button
                        v-tooltip="{
                            message: $tc('sw-privileges.tooltip.warning'),
                            disabled: acl.can('channel.editor'),
                            showOnDisabledElements: true
                        }"
                        ghost
                        size="small"
                        :disabled="!acl.can('channel.editor')"
                        variant="secondary"
                        @click="openAddProductsModal"
                    >
                        {{ $tc('sw-channel.detail.questions.buttonAddProducts', {}, 0) }}
                    </mt-button>
                    {% endblock %}
                </sw-container>
            </sw-card-section>
            {% endblock %}

            {% block sw_channel_detail_questions_card_section_primary %}
            <sw-card-section divider="top">
                {% block sw_channel_detail_questions_card_section_primary_filled_state %}
                <sw-entity-listing
                    v-if="questions.length > 0"
                    ref="entityListing"
                    class="sw-channel-detail-questions__list"
                    identifier="sw-channel-detail-questions-list"
                    detail-route="sw.question.detail"
                    :repository="questionRepository"
                    :items="questions"
                    :data-source="questions"
                    :columns="questionColumns"
                    :plain-appearance="true"
                    :skeleton-item-amount="limit"
                    :is-loading="isLoading"
                    :allow-inline-edit="false"
                    :allow-view="acl.can('channel.viewer')"
                    :allow-edit="acl.can('question.editor')"
                    :allow-delete="acl.can('channel.deleter')"
                    :is-record-selectable="isProductRemovable"
                    @selection-change="onProductSelectionChanged"
                >
                    <template #selection-content="{ item, isSelected, isRecordSelectable, selectItem, itemIdentifierProperty }">
                        <slot v-bind="{ item, isSelected, isRecordSelectable, selectItem, itemIdentifierProperty }">
                            <div class="sw-data-grid__cell-content">
                                {% block sw_channel_detail_questions_listing_select_item_checkbox %}
                                <mt-checkbox
                                    v-tooltip="{
                                        message: $tc('sw-channel.detail.questions.inheritVariantNotRemovableTooltip'),
                                        disabled: isRecordSelectable(item),
                                        showOnDisabledElements: true
                                    }"
                                    :disabled="!isRecordSelectable(item)"
                                    :checked="isSelected(item[itemIdentifierProperty])"
                                    @update:checked="selectItem($event, item)"
                                />
                                {% endblock %}
                            </div>
                        </slot>
                    </template>
                    <template #column-name="{ item }">
                        <slot v-bind="{ item }">
                            {% block sw_channel_detail_questions_listing_column_name %}
                            <sw-question-variant-info
                                :variations="item.variation"
                            >
                                <router-link :to="{ name: 'sw.question.detail', params: { id: item.id } }">
                                    {{ item.translated.name || item.name }}
                                </router-link>
                            </sw-question-variant-info>
                            {% endblock %}
                        </slot>
                    </template>

                    <template #column-active="{ item }">
                        {% block sw_channel_detail_questions_listing_column_active %}
                        <mt-icon
                            size="16px"
                            :name="item.active === false ? 'regular-times-s' : 'regular-checkmark-xs'"
                            :color="item.active === false ? '#de294c' : '#37d046'"
                        />
                        {% endblock %}
                    </template>

                    <template #pagination>
                        {% block sw_channel_detail_questions_listing_pagination %}
                        <sw-pagination
                            v-bind="{ page, limit, total }"
                            :total-visible="5"
                            :auto-hide="false"
                            @page-change="onChangePage"
                        />
                        {% endblock %}
                    </template>

                    <template #delete-action="{ item }">
                        {% block sw_channel_detail_questions_listing_delete_action %}
                        <sw-context-menu-item
                            variant="warning"
                            :disabled="!isProductRemovable(item)"
                            @click="onDeleteProduct(item)"
                        >
                            {{ $tc('global.default.remove') }}
                        </sw-context-menu-item>
                        {% endblock %}
                    </template>

                    <template #bulk>
                        {% block sw_channel_detail_questions_listing_bulk %}
                        <a
                            class="link link-warning"
                            role="button"
                            tabindex="0"
                            @click="onDeleteProducts"
                            @keydown.enter="onDeleteProducts"
                        >
                            {{ $tc('global.default.remove') }}
                        </a>
                        {% endblock %}
                    </template>
                </sw-entity-listing>
                {% endblock %}

                {% block sw_channel_detail_questions_card_section_primary_empty_state %}
                <sw-empty-state
                    v-else
                    :show-description="false"
                    :title="$tc('sw-channel.detail.questions.titleEmptyStateTable')"
                >
                    <template #icon>
                        {% block sw_channel_detail_questions_card_section_primary_image %}
                        <img
                            :src="assetFilter('/administration/administration/static/img/empty-states/questions-empty-state.svg')"
                            :alt="$tc('sw-channel.detail.questions.titleEmptyStateTable')"
                        >
                        {% endblock %}
                    </template>
                </sw-empty-state>
                {% endblock %}
            </sw-card-section>
            {% endblock %}
        </sw-container>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_channel_detail_questions_empty_state %}
    <sw-empty-state
        v-if="questions.length <= 0 && !searchTerm && !isLoading"
        :show-description="false"
        :absolute="false"
        :title="$tc('sw-channel.detail.questions.titleEmptyState')"
    >
        <template #icon>
            {% block sw_channel_detail_questions_empty_state_image %}
            <img
                :src="assetFilter('/administration/administration/static/img/empty-states/questions-empty-state.svg')"
                :alt="$tc('sw-channel.detail.questions.titleEmptyState')"
            >
            {% endblock %}
        </template>

        <template #actions>
            {% block sw_channel_detail_questions_empty_state_button %}
            <mt-button
                v-tooltip="{
                    message: $tc('sw-privileges.tooltip.warning'),
                    disabled: acl.can('channel.editor'),
                    showOnDisabledElements: true
                }"
                ghost
                :disabled="!acl.can('channel.editor')"
                variant="secondary"
                @click="openAddProductsModal"
            >
                {{ $tc('sw-channel.detail.questions.buttonAddProducts', {}, 0) }}
            </mt-button>
            {% endblock %}
        </template>
    </sw-empty-state>
    {% endblock %}

    {% block sw_channel_detail_questions_assignment_modal %}
    <sw-channel-questions-assignment-modal
        v-if="showProductsModal"
        :channel="channel"
        :is-assign-question-loading="isAssignProductLoading"
        @modal-close="showProductsModal = false"
        @questions-add="onAddProducts"
    />
    {% endblock %}
</mt-card>
{% endblock %}
