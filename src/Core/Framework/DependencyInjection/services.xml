<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:monolog="http://symfony.com/schema/dic/monolog"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd http://symfony.com/schema/dic/monolog http://symfony.com/schema/dic/monolog/monolog-1.0.xsd">
    <parameters>
        <parameter key="heypanel.slug.config" type="collection">
            <parameter key="regexp">/([^A-Za-z0-9\.]|-)+/</parameter>
            <parameter key="lowercase">false</parameter>
        </parameter>

        <!-- Populated by RouteScopeCompilerPass with all route prefixes from the registers RouteScopes -->
        <parameter key="heypanel.routing.registered_api_prefixes" type="collection"/>

        <!-- Migration config -->
        <parameter key="core.migration.directories" type="collection"/>

        <parameter key="heypanel.security.csp_templates" type="collection">
            <parameter key="default">
object-src 'none';
script-src 'none';
base-uri 'self';
frame-ancestors 'none';
            </parameter>
            <parameter key="administration">
object-src 'none';
script-src 'strict-dynamic' 'nonce-%%nonce%%' 'unsafe-inline' 'unsafe-eval' https: http:;
base-uri 'self';
frame-ancestors 'none';
            </parameter>
            <parameter key="frontend"/>
            <parameter key="installer"/>
        </parameter>

        <parameter key="heypanel_http_cache_enabled_default">1</parameter>
        <parameter key="heypanel.http.cache.enabled">%env(default:heypanel_http_cache_enabled_default:SHOPWARE_HTTP_CACHE_ENABLED)%</parameter>

        <parameter key="heypanel_http_cache_default_ttl_default">7200</parameter>
        <parameter key="heypanel.http.cache.default_ttl">%env(default:heypanel_http_cache_default_ttl_default:SHOPWARE_HTTP_DEFAULT_TTL)%</parameter>
    </parameters>
    <monolog:config>
        <monolog:channel>business_events</monolog:channel>

        <monolog:handler
            name="business_event_handler_buffer"
            type="buffer"
            handler="business_event_handler">
            <monolog:channels>
                <monolog:channel>business_events</monolog:channel>
            </monolog:channels>
        </monolog:handler>

        <monolog:handler
            name="business_event_handler"
            type="service"
            id="HeyPanel\Core\Framework\Log\Monolog\DoctrineSQLHandler">
            <monolog:channels>
                <monolog:channel>business_events</monolog:channel>
            </monolog:channels>
        </monolog:handler>
    </monolog:config>
    <services>
        <!-- Database / Doctrine -->
        <service id="Doctrine\DBAL\Connection" public="true">
            <factory class="HeyPanel\Core\Kernel" method="getConnection"/>
        </service>

        <service id="HeyPanel\Core\Framework\Routing\QueryDataBagResolver">
            <tag name="controller.argument_value_resolver" priority="1000"/>
        </service>

        <service id="HeyPanel\Core\Framework\Routing\RequestDataBagResolver">
            <tag name="controller.argument_value_resolver" priority="1000"/>
        </service>

        <!-- Migration -->
        <service id="HeyPanel\Core\Framework\Migration\MigrationSource.core"
                 class="HeyPanel\Core\Framework\Migration\MigrationSource">
            <argument type="string">core</argument>
            <tag name="heypanel.migration_source"/>
        </service>

        <service id="HeyPanel\Core\Framework\Migration\MigrationSource.core.V6_7"
                 class="HeyPanel\Core\Framework\Migration\MigrationSource">
            <argument type="string">core.V6_7</argument>
            <tag name="heypanel.migration_source"/>
        </service>

        <service id="HeyPanel\Core\Framework\Migration\MigrationSource.core.V6_8"
                 class="HeyPanel\Core\Framework\Migration\MigrationSource">
            <argument type="string">core.V6_8</argument>
            <tag name="heypanel.migration_source"/>
        </service>

        <service id="HeyPanel\Core\Framework\Migration\MigrationSource.null"
                 class="HeyPanel\Core\Framework\Migration\MigrationSource">
            <argument type="string">null</argument>
            <argument type="collection"/>

            <tag name="heypanel.migration_source"/>
        </service>

        <service id="HeyPanel\Core\Framework\Migration\MigrationRuntime">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="HeyPanel\Core\Framework\Migration\MigrationCollectionLoader" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="HeyPanel\Core\Framework\Migration\MigrationRuntime"/>
            <argument type="service" id="logger"/>
            <argument type="tagged_iterator" tag="heypanel.migration_source"/>
        </service>

        <service id="HeyPanel\Core\Framework\Migration\Command\CreateMigrationCommand">
            <argument type="service" id="HeyPanel\Core\Framework\Plugin\KernelPluginCollection"/>
            <argument>%kernel.heypanel_core_dir%</argument>
            <argument>%kernel.heypanel_version%</argument>
            <tag name="console.command"/>
        </service>

        <service id="HeyPanel\Core\Framework\Migration\Command\RefreshMigrationCommand">
            <tag name="console.command"/>
        </service>

        <service id="HeyPanel\Core\Framework\Migration\Command\MigrationCommand">
            <argument type="service" id="HeyPanel\Core\Framework\Migration\MigrationCollectionLoader"/>
            <argument type="service" id="cache.object"/>
            <argument type="string">%kernel.heypanel_version%</argument>

            <tag name="console.command"/>
        </service>

        <service id="HeyPanel\Core\Framework\Adapter\Storage\AbstractKeyValueStorage"
                 class="HeyPanel\Core\Framework\Adapter\Storage\MySQLKeyValueStorage" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="HeyPanel\Core\Framework\Migration\Command\MigrationDestructiveCommand">
            <argument type="service" id="HeyPanel\Core\Framework\Migration\MigrationCollectionLoader"/>
            <argument type="service" id="cache.object"/>
            <argument type="string">%kernel.heypanel_version%</argument>

            <tag name="console.command"/>
        </service>

        <service id="HeyPanel\Core\Framework\Migration\IndexerQueuer" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="HeyPanel\Core\Framework\Util\HtmlSanitizer" public="true">
            <argument>%heypanel.html_sanitizer.cache_dir%</argument>
            <argument>%heypanel.html_sanitizer.cache_enabled%</argument>
            <argument>%heypanel.html_sanitizer.sets%</argument>
            <argument>%heypanel.html_sanitizer.fields%</argument>
            <argument>%heypanel.html_sanitizer.enabled%</argument>
        </service>

        <service id="HeyPanel\Core\Framework\Adapter\Cache\RedisConnectionFactory">
            <argument>%heypanel.cache.redis_prefix%</argument>
        </service>

        <service id="HeyPanel\Core\Framework\Adapter\Redis\RedisConnectionProvider">
            <argument/>  <!-- $serviceLocator will be set in the compiler pass -->
        </service>

        <!-- Routing -->
        <service id="HeyPanel\Core\Framework\Routing\RouteScope">
            <tag name="heypanel.route_scope"/>
        </service>

        <service id="HeyPanel\Core\Framework\Routing\RouteScopeListener">
            <argument type="service" id="HeyPanel\Core\Framework\Routing\RouteScopeRegistry"/>
            <argument type="service" id="request_stack"/>
            <argument type="tagged_iterator" tag="heypanel.route_scope_whitelist"/>

            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="HeyPanel\Core\Framework\Routing\RouteEventSubscriber">
            <tag name="kernel.event_subscriber"/>
            <argument type="service" id="event_dispatcher"/>
        </service>

        <service id="HeyPanel\Core\Framework\Routing\MaintenanceModeResolver">
            <argument type="service" id="event_dispatcher"/>
        </service>

        <service id="HeyPanel\Core\Framework\Routing\SymfonyRouteScopeWhitelist">
            <tag name="heypanel.route_scope_whitelist"/>
        </service>

        <service id="HeyPanel\Core\Framework\Routing\ApiRouteScope">
            <tag name="heypanel.route_scope"/>
        </service>

        <service id="HeyPanel\Core\Framework\Routing\ClientApiRouteScope">
            <tag name="heypanel.route_scope"/>
        </service>

        
        <service id="HeyPanel\Core\Framework\Routing\ContextResolverListener">
            <argument type="service" id="HeyPanel\Core\Framework\Routing\ApiRequestContextResolver"/>

            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="HeyPanel\Core\Framework\Routing\RouteScopeRegistry">
            <argument type="tagged_iterator" tag="heypanel.route_scope"/>
        </service>

        <service id="HeyPanel\Core\Framework\Routing\ApiRequestContextResolver">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="HeyPanel\Core\Framework\Routing\RouteScopeRegistry"/>
        </service>

        <service id="HeyPanel\Core\Framework\Routing\Annotation\CriteriaValueResolver">
            <argument type="service" id="HeyPanel\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="HeyPanel\Core\Framework\DataAbstractionLayer\Search\RequestCriteriaBuilder"/>
            <tag name="controller.argument_value_resolver"/>
        </service>
        
        <service id="HeyPanel\Core\Framework\Feature\Command\FeatureDumpCommand">
            <argument type="service" id="kernel"/>

            <tag name="console.command"/>
            <tag name="console.command" command="administration:dump:features"/>
        </service>
        
        <service id="HeyPanel\Core\Framework\Feature\Command\FeatureDisableCommand">
            <argument type="service" id="HeyPanel\Core\Framework\Feature\FeatureFlagRegistry"/>
            <argument type="service" id="HeyPanel\Core\Framework\Adapter\Cache\CacheClearer"/>

            <tag name="console.command"/>
        </service>

        <service id="HeyPanel\Core\Framework\Feature\Command\FeatureEnableCommand">
            <argument type="service" id="HeyPanel\Core\Framework\Feature\FeatureFlagRegistry"/>
            <argument type="service" id="HeyPanel\Core\Framework\Adapter\Cache\CacheClearer"/>

            <tag name="console.command"/>
        </service>

        <service id="HeyPanel\Core\Framework\Feature\Command\FeatureListCommand">
            <tag name="console.command"/>
        </service>
        <!-- Logging -->
        <service id="HeyPanel\Core\Framework\Log\LoggingService">
            <argument>%kernel.environment%</argument>
            <tag name="kernel.event_subscriber"/>
            <argument type="service" id="monolog.logger.business_events"/>
        </service>

        <service id="HeyPanel\Core\Framework\Log\ExceptionLogger">
            <argument>%kernel.environment%</argument>
            <argument>%heypanel.logger.enforce_throw_exception%</argument>
            <argument type="service" id="logger"/>
        </service>

        <service id="HeyPanel\Core\Framework\Log\ScheduledTask\LogCleanupTask">
            <tag name="heypanel.scheduled.task"/>
        </service>

        <service id="HeyPanel\Core\Framework\Log\ScheduledTask\LogCleanupTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="HeyPanel\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>

            <tag name="messenger.message_handler"/>
        </service>

        <service id="HeyPanel\Core\Framework\Log\Monolog\DoctrineSQLHandler">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="HeyPanel\Core\Framework\Log\LogEntryDefinition">
            <tag name="heypanel.entity.definition"/>
        </service>
        
        
        <!-- Snippets -->
        <service id="HeyPanel\Core\System\Snippet\SnippetService" lazy="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="HeyPanel\Core\System\Snippet\Files\SnippetFileCollection"/>
            <argument type="service" id="snippet.repository"/>
            <argument type="service" id="snippet_set.repository"/>
            <argument type="service" id="HeyPanel\Core\System\Snippet\Filter\SnippetFilterFactory"/>
            <argument type="service" id="HeyPanel\Core\Framework\Extensions\ExtensionDispatcher"/>
            <argument type="service" id="event_dispatcher"/>
        </service>

        <service id="HeyPanel\Core\System\Snippet\Api\SnippetController" public="true">
            <argument type="service" id="HeyPanel\Core\System\Snippet\SnippetService"/>
            <argument type="service" id="HeyPanel\Core\System\Snippet\Files\SnippetFileCollection"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="HeyPanel\Core\System\Snippet\Files\SnippetFileLoader">
            <argument type="service" id="Symfony\Component\HttpKernel\KernelInterface"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="HeyPanel\Core\System\Snippet\Files\SnippetFileCollection" public="true" lazy="true">
            <factory service="HeyPanel\Core\System\Snippet\Files\SnippetFileCollectionFactory"
                     method="createSnippetFileCollection"/>
        </service>

        <service id="HeyPanel\Core\System\Snippet\Files\SnippetFileCollectionFactory">
            <argument type="service" id="HeyPanel\Core\System\Snippet\Files\SnippetFileLoader"/>
        </service>

        <service id="HeyPanel\Core\System\Snippet\Filter\SnippetFilterFactory" public="true">
            <argument type="tagged_iterator" tag="heypanel.snippet.filter"/>
        </service>

        <!--SnippetFilters-->
        <service id="HeyPanel\Core\System\Snippet\Filter\AuthorFilter">
            <tag name="heypanel.snippet.filter"/>
        </service>

        <service id="HeyPanel\Core\System\Snippet\Filter\AddedFilter">
            <tag name="heypanel.snippet.filter"/>
        </service>

        <service id="HeyPanel\Core\System\Snippet\Filter\EditedFilter">
            <tag name="heypanel.snippet.filter"/>
        </service>

        <service id="HeyPanel\Core\System\Snippet\Filter\EmptySnippetFilter">
            <tag name="heypanel.snippet.filter"/>
        </service>

        <service id="HeyPanel\Core\System\Snippet\Filter\NamespaceFilter">
            <tag name="heypanel.snippet.filter"/>
        </service>

        <service id="HeyPanel\Core\System\Snippet\Filter\TermFilter">
            <tag name="heypanel.snippet.filter"/>
        </service>

        <service id="HeyPanel\Core\System\Snippet\Filter\TranslationKeyFilter">
            <tag name="heypanel.snippet.filter"/>
        </service>

        <service id="HeyPanel\Core\Framework\DataAbstractionLayer\Indexing\TreeUpdater">
            <argument type="service" id="HeyPanel\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>
        
        <!-- Cache -->
        <service class="Cocur\Slugify\Slugify" public="false" id="slugify">
            <argument>%heypanel.slug.config%</argument>
        </service>
        
        <!-- Twig -->
        <service id="HeyPanel\Core\Framework\Adapter\Twig\TemplateFinder" public="true">
            <argument type="service" id="twig"/>
            <argument type="service" id="twig.loader"/>
            <argument>%twig.cache%</argument>
            <argument type="service"
                      id="HeyPanel\Core\Framework\Adapter\Twig\NamespaceHierarchy\NamespaceHierarchyBuilder"/>
            <argument type="service" id="HeyPanel\Core\Framework\Adapter\Twig\TemplateScopeDetector"/>

            <tag name="kernel.reset" method="reset"/>
        </service>

        <service id="HeyPanel\Core\Framework\Adapter\Twig\NamespaceHierarchy\NamespaceHierarchyBuilder">
            <argument type="tagged_iterator" tag="heypanel.twig.hierarchy_builder"/>
        </service>


        <service id="HeyPanel\Core\Framework\Adapter\Twig\NamespaceHierarchy\BundleHierarchyBuilder">
            <argument type="service" id="kernel"/>
            <tag name="heypanel.twig.hierarchy_builder" priority="1000"/>
        </service>

        <service id="HeyPanel\Core\Framework\Adapter\Twig\TemplateScopeDetector">
            <argument type="service" id="request_stack"/>
        </service>

        <service id="HeyPanel\Core\Framework\Adapter\Twig\Extension\NodeExtension">
            <argument type="service" id="HeyPanel\Core\Framework\Adapter\Twig\TemplateFinder"/>
            <argument type="service" id="HeyPanel\Core\Framework\Adapter\Twig\TemplateScopeDetector"/>
            <tag name="twig.extension"/>
        </service>

        <service id="HeyPanel\Core\Framework\Adapter\Twig\Extension\PhpSyntaxExtension">
            <tag name="twig.extension" />
        </service>

        <service id="HeyPanel\Core\Framework\Adapter\Twig\Extension\FeatureFlagExtension">
            <tag name="twig.extension"/>
        </service>

        <service class="Twig\Extra\Intl\IntlExtension" id="twig.extension.intl">
            <tag name="twig.extension"/>
        </service>

        <service class="Twig\Extra\String\StringExtension" id="twig.extension.string">
            <tag name="twig.extension"/>
        </service>

        <service id="HeyPanel\Core\Framework\Adapter\Twig\Extension\PcreExtension">
            <tag name="twig.extension"/>
        </service>

        <service id="HeyPanel\Core\Framework\Adapter\Twig\Extension\InstanceOfExtension">
            <tag name="twig.extension"/>
        </service>

        <service id="HeyPanel\Core\Framework\Adapter\Twig\Filter\CurrencyFilter">
            <argument type="service" id="HeyPanel\Core\System\Currency\CurrencyFormatter"/>
            <tag name="twig.extension"/>
        </service>

        <service id="HeyPanel\Core\Framework\Adapter\Twig\Filter\EmailIdnTwigFilter">
            <tag name="twig.extension"/>
        </service>

        <service id="HeyPanel\Core\Framework\Adapter\Twig\Filter\LeadingSpacesFilter" >
            <tag name="twig.extension"/>
        </service>

        <service id="Cocur\Slugify\Bridge\Twig\SlugifyExtension">
            <argument type="service" id="slugify"/>
            <tag name="twig.extension"/>
        </service>

        <service id="HeyPanel\Core\Framework\Adapter\Twig\Filter\ReplaceRecursiveFilter">
            <tag name="twig.extension"/>
        </service>

        <service id="HeyPanel\Core\Framework\Adapter\Twig\SecurityExtension">
            <argument>%heypanel.twig.allowed_php_functions%</argument>
            <tag name="twig.extension"/>
        </service>

        <service id="HeyPanel\Core\Framework\Adapter\Twig\StringTemplateRenderer">
            <argument type="service" id="twig"/>
            <argument>%twig.cache%</argument>
        </service>

        <service id="HeyPanel\Core\Framework\Adapter\Twig\TemplateIterator"
                 decorates="twig.template_iterator"
                 public="true">
            <argument type="service" id="HeyPanel\Core\Framework\Adapter\Twig\TemplateIterator.inner"/>
            <argument>%kernel.bundles%</argument>
        </service>

        <service id="HeyPanel\Core\Framework\Adapter\Twig\TwigVariableParserFactory"/>

         <!-- Translation -->
        <service id="HeyPanel\Core\Framework\Adapter\Translation\Translator" decorates="translator">
            <argument type="service" id="HeyPanel\Core\Framework\Adapter\Translation\Translator.inner"/>
            <argument type="service" id="request_stack"/>
            <argument type="service" id="cache.object"/>
            <argument type="service" id="translator.formatter"/>
            <argument>%kernel.environment%</argument>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="HeyPanel\Core\System\Locale\LanguageLocaleCodeProvider"/>
            <argument type="service" id="HeyPanel\Core\System\Snippet\SnippetService"/>
            <argument type="service" id="event_dispatcher"/>

            <tag name="monolog.logger"/>
        </service>
    </services>
</container>