<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="HeyPanel\Core\Framework\Event\BusinessEventRegistry" public="true"/>

        <!--Event Listener -->
        <service id="HeyPanel\Core\Framework\Event\NestedEventDispatcher" decorates="event_dispatcher">
            <argument type="service" id="HeyPanel\Core\Framework\Event\NestedEventDispatcher.inner"/>
        </service>

        <service id="HeyPanel\Core\Framework\Extensions\ExtensionDispatcher">
            <argument type="service" id="event_dispatcher"/>
        </service>

    </services>
</container>
