<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="HeyPanel\Core\Content\Rule\RuleDefinition">
            <tag name="heypanel.entity.definition"/>
        </service>
        <service id="HeyPanel\Core\Content\Rule\Aggregate\RuleCondition\RuleConditionDefinition">
            <tag name="heypanel.entity.definition"/>
        </service>
        <service id="HeyPanel\Core\Content\Rule\Aggregate\RuleTag\RuleTagDefinition">
            <tag name="heypanel.entity.definition"/>
        </service>

        <service id="HeyPanel\Core\Content\Rule\RuleValidator">
            <argument type="service" id="validator"/>
            <argument type="service" id="HeyPanel\Core\Framework\Rule\Collector\RuleConditionRegistry"/>
            <argument type="service" id="rule_condition.repository" />

            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="HeyPanel\Core\Content\Rule\DataAbstractionLayer\RuleIndexer">
            <argument type="service" id="HeyPanel\Core\Framework\DataAbstractionLayer\Dbal\Common\IteratorFactory"/>
            <argument type="service" id="rule.repository"/>
            <argument type="service" id="HeyPanel\Core\Content\Rule\DataAbstractionLayer\RuleAreaUpdater"/>
            <argument type="service" id="event_dispatcher"/>
            <tag name="heypanel.entity_indexer"/>
        </service>

        <service id="HeyPanel\Core\Content\Rule\DataAbstractionLayer\RuleIndexerSubscriber">
            <tag name="kernel.event_subscriber"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="HeyPanel\Core\Content\Rule\DataAbstractionLayer\RuleAreaUpdater">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="HeyPanel\Core\Content\Rule\RuleDefinition"/>
            <argument type="service" id="HeyPanel\Core\Framework\Rule\Collector\RuleConditionRegistry"/>
            <argument type="service" id="HeyPanel\Core\Framework\Adapter\Cache\CacheInvalidator"/>
            <argument type="service" id="HeyPanel\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>
