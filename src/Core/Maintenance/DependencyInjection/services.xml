<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
    <parameters>
        <parameter key="env(APP_URL_CHECK_DISABLED)" type="string">false</parameter>
    </parameters>
    <services>

        <service id="HeyPanel\Core\Maintenance\Channel\Command\ChannelCreateCommand">
            <argument type="service" id="HeyPanel\Core\Maintenance\Channel\Service\ChannelCreator"/>

            <tag name="console.command"/>
        </service>

        <service id="HeyPanel\Core\Maintenance\Channel\Service\ChannelCreator" public="true">
            <argument type="service" id="HeyPanel\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="channel.repository"/>
            <argument type="service" id="country.repository"/>
            <argument type="service" id="category.repository"/>
        </service>

        <service id="HeyPanel\Core\Maintenance\System\Service\DatabaseConnectionFactory"/>
        <service id="HeyPanel\Core\Maintenance\System\Service\SetupDatabaseAdapter"/>

        <service id="HeyPanel\Core\Maintenance\System\Command\SystemInstallCommand">
            <argument>%kernel.project_dir%</argument>
            <argument type="service" id="HeyPanel\Core\Maintenance\System\Service\SetupDatabaseAdapter"/>
            <argument type="service" id="HeyPanel\Core\Maintenance\System\Service\DatabaseConnectionFactory"/>
            <tag name="console.command"/>
        </service>

        <service id="HeyPanel\Core\Maintenance\System\Command\SystemIsInstalledCommand">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <tag name="console.command"/>
        </service>

        <service id="HeyPanel\Core\Maintenance\System\Command\SystemGenerateAppSecretCommand">
            <tag name="console.command"/>
        </service>

        <service id="HeyPanel\Core\Maintenance\System\Command\SystemSetupCommand">
            <argument>%kernel.project_dir%</argument>
            <argument type="service" id="Symfony\Component\Dotenv\Command\DotenvDumpCommand"/>
            <tag name="console.command"/>
        </service>

        <service id="Symfony\Component\Dotenv\Command\DotenvDumpCommand">
            <argument>%kernel.project_dir%</argument>
            <tag name="console.command"/>
        </service>

        <service id="HeyPanel\Core\Maintenance\System\Command\SystemUpdatePrepareCommand">
            <argument type="service" id="service_container"/>
            <argument>%kernel.heypanel_version%</argument>
            <tag name="console.command"/>
        </service>

        <service id="HeyPanel\Core\Maintenance\System\Command\SystemUpdateFinishCommand">
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="HeyPanel\Core\System\SystemConfig\SystemConfigService"/>
            <argument>%kernel.heypanel_version%</argument>
            <tag name="console.command"/>
        </service>
        
        <service id="HeyPanel\Core\Maintenance\System\Command\SystemConfigureWebsiteCommand">
            <argument type="service" id="HeyPanel\Core\Maintenance\System\Service\WebsiteConfigurator"/>
            <argument type="service" id="HeyPanel\Core\Framework\Adapter\Cache\CacheClearer"/>

            <tag name="console.command"/>
        </service>

        <service id="HeyPanel\Core\Maintenance\System\Service\AppUrlVerifier">
            <argument type="service" id="heypanel.maintenance.client"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument>%kernel.environment%</argument>
            <argument>%env(bool:APP_URL_CHECK_DISABLED)%</argument>
        </service>

        <service id="heypanel.maintenance.client" class="GuzzleHttp\Client"/>

        <service id="HeyPanel\Core\Maintenance\System\Service\WebsiteConfigurator">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Symfony\Component\EventDispatcher\EventDispatcherInterface"/>
        </service>
        <service id="HeyPanel\Core\Maintenance\User\Command\UserCreateCommand">
            <argument type="service" id="HeyPanel\Core\Maintenance\User\Service\UserProvisioner"/>
            <tag name="console.command"/>
        </service>

        <service id="HeyPanel\Core\Maintenance\User\Command\UserChangePasswordCommand">
            <argument type="service" id="user.repository"/>
            <tag name="console.command"/>
        </service>

        <service id="HeyPanel\Core\Maintenance\User\Command\UserListCommand">
            <argument type="service" id="user.repository"/>
            <tag name="console.command"/>
        </service>

        <service id="HeyPanel\Core\Maintenance\User\Service\UserProvisioner" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>
    </services>
</container>
